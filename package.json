{
  "name": "wattr-replit-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:setup": "tsx scripts/setup-database.ts",
    "security:provision-owner": "npm run db:setup && tsx scripts/provision-owner.ts",
    "dev": "npm run db:setup && tsx server/index.ts",
    "build": "vite build",
